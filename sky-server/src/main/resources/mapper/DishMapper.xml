<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.DishMapper">

    <!-- 菜品 VO 及其口味列表的嵌套映射 -->
    <resultMap id="dishVOWithFlavors" type="com.sky.vo.DishVO">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="categoryId" column="category_id"/>
        <result property="categoryName" column="category_name"/>
        <result property="price" column="price"/>
        <result property="image" column="image"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="updateTime" column="update_time"/>
        <!-- 每个口味对应一个 DishFlavor 对象，装进 flavors 列表 -->
        <collection property="flavors" ofType="com.sky.entity.DishFlavor">
            <id property="id" column="flavor_id"/>
            <result property="dishId" column="dish_id"/>
            <result property="name" column="flavor_name"/>
            <result property="value" column="value"/>
        </collection>
    </resultMap>

    <!--新增菜品-->
    <insert id="saveDish" useGeneratedKeys="true" keyProperty="id">
        insert into sky_take_out.dish(name, category_id, price, image, description, status)
        values (#{name}, #{categoryId}, #{price}, #{image}, #{description}, #{status})
    </insert>

    <!--新增菜品口味-->
    <insert id="saveFlavors">
        insert into sky_take_out.dish_flavor(dish_id, name, value) values
        <foreach collection="dishFlavors" item="flavor" separator=",">
            (#{flavor.dishId}, #{flavor.name}, #{flavor.value})
        </foreach>
    </insert>

    <!--菜品分页查询(只查菜品本身, 口味单独批量查, 避免分页总数不准)-->
    <select id="pageQuery" resultType="com.sky.vo.DishVO">
        select
            d.id,
            d.name,
            c.id as categoryId,
            c.name as categoryName,
            d.price,
            d.image,
            d.description,
            d.status,
            d.update_time as updateTime
        from sky_take_out.dish as d
        left join sky_take_out.category as c on d.category_id = c.id
        <where>
        <if test="name != null and name != ''">
            d.name like concat('%', #{name}, '%')
        </if>
        <if test="categoryId != null">
            d.category_id = #{categoryId}
        </if>
        <if test="status != null">
            d.status = #{status}
        </if>
        </where>
        order by d.category_id, d.id
    </select>

    <!--批量根据菜品id查询口味(分页后用, 用于填充当前页菜品的口味列表)-->
    <select id="getFlavorsByDishIds" resultType="com.sky.entity.DishFlavor">
        select
            id,
            dish_id as dishId,
            name,
            value
        from sky_take_out.dish_flavor
        where dish_id in
        <foreach collection="dishIds" item="dishId" open="(" separator="," close=")">
            #{dishId}
        </foreach>
    </select>

    <!--根据菜品id查询-->
    <select id="queryById" resultMap="dishVOWithFlavors">
        select
            d.id,
            d.name,
            c.id as category_id,
            c.name as category_name,
            d.price,
            d.image,
            d.description,
            d.status,
            d.update_time,
            df.id as flavor_id,
            df.dish_id as dish_id,
            df.name as flavor_name,
            df.value as value
        from sky_take_out.dish as d
        left join sky_take_out.dish_flavor as df on d.id = df.dish_id
        left join sky_take_out.category as c on d.category_id = c.id
        <where>
            d.id = #{id}
        </where>
        order by d.category_id, d.id
    </select>

    <!--更新菜品信息-->
    <update id="update">
        update sky_take_out.dish
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="categoryId != null">
                category_id = #{categoryId},
            </if>
            <if test="price != null">
                price = #{price},
            </if>
            <if test="image != null and image != ''">
                image = #{image},
            </if>
            <if test="description != null and description != ''">
                description = #{description},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
        </set>
        <where>
            id = #{id}
        </where>
    </update>

    <!--更新菜品口味-->
    <update id="updateFlavors">
        update sky_take_out.dish_flavor
        <foreach collection="dishFlavors" item="flavor" separator=",">
            <set>
                <if test="flavor.name != null and flavor.name != ''">
                    name = #{flavor.name},
                </if>
                <if test="flavor.value != null">
                    value = #{flavor.value},
                </if>
            </set>
            <where>
                dish_id = #{flavor.dishId} and id = #{flavor.id}
            </where>
        </foreach>
    </update>
</mapper>